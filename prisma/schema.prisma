generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Media {
  id              String           @id @default(cuid())
  externalId      String           // e.g., "550", "elden-ring"
  mediaType       String           // "movie" | "game" | "book" | "song"
  sourceApi       String           // "tmdb" | "rawg" | "google_books" | "spotify"
  title           String
  posterUrl       String?
  metadata        Json             // Full raw response, genres, release year, etc.
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  recommendations Recommendation[]
  favorites       Favorite[]

  @@unique([mediaType, externalId]) // Guarantees no duplicate movies/games in your DB
  @@index([mediaType])
}

model SearchQuery {
  id              String           @id @default(cuid())
  rawInput        String
  mode            String           // "title" | "vibe"
  resolvedType    String?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime         @default(now())
  recommendations Recommendation[]

  @@index([rawInput])
}

model Recommendation {
  id          String      @id @default(cuid())
  queryId     String
  query       SearchQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  
  // Link to the centralized Media table
  mediaId     String
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  verified    Boolean     @default(false)
  matchReason String
  createdAt   DateTime    @default(now())

  @@index([queryId])
  @@index([mediaId])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  createdAt DateTime   @default(now())
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Users now favorite the Media item directly, not a temporary recommendation
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mediaId])
}
