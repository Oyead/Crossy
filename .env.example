DATABASE_URL=postgresql://user:pass@host:5432/db
DIRECT_URL=postgresql://user:pass@host:5432/db

TMDB_API_KEY=your_tmdb_api_key
RAWG_API_KEY=your_rawg_api_key

GEMINI_API_KEY=your_gemini_api_key

# Embeddings (Gemini is the only active provider; re-embed rows once when switching models)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1536

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# OPENROUTER_API_KEY and OPEN_ROUTER_API_KEY are both accepted
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional legacy provider; not used by the active Gemini embedding path
# OPENAI_API_KEY=your_openai_api_key

# Optional LLM routing, budgets, and cooldowns
# LLM_PROVIDER_ORDER_CANDIDATES=groq,gemini,openrouter
# LLM_PROVIDER_ORDER_RANK=gemini,groq,openrouter
# LLM_DAILY_BUDGET=500
# LLM_PER_MINUTE_LIMIT=20
# LLM_QUOTA_COOLDOWN_MS=3600000
# LLM_CONFIG_COOLDOWN_MS=86400000
# LLM_TRANSIENT_BACKOFF_MS=60000
# LLM_MAX_BACKOFF_MS=1800000
# GEMINI_CANDIDATES_MODEL=gemini-flash-latest
# GEMINI_RANK_MODEL=gemini-flash-latest

UPSTASH_REDIS_REST_URL=https://your-upstash-host.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

RESEND_API_KEY=your_resend_api_key
MAIL_FROM="Crossy <onboarding@resend.dev>"
