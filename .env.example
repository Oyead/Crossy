# PostgreSQL connection (Neon/Supabase/any Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/db
DIRECT_URL=postgresql://user:pass@host:5432/db

# Media provider APIs
TMDB_API_KEY=your_tmdb_api_key
RAWG_API_KEY=your_rawg_api_key
# Music (iTunes Search API) and Books (Open Library) are free and keyless — no keys needed.

# AI recommendation engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Upstash Redis (rate limiting + result caching)
UPSTASH_REDIS_REST_URL=https://your-upstash-host.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Public app URL (used for links/SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000
